---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  PUBLIC_GOOGLE_SITE_VERIFICATION,
  PUBLIC_NAVER_SITE_VERIFICATION,
} from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";

type HreflangAlt = { lang: string; href: string };

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  noIndex?: boolean;
  htmlLang?: string;
  hreflangAlternates?: HreflangAlt[];
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, SITE.website),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  noIndex = false,
  htmlLang,
  hreflangAlternates,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

// Emit BlogPosting schema only on actual post pages (identified by pubDatetime).
// Other pages get WebSite schema, which is cleaner for the site root and
// avoids Google flagging non-article pages as articles.
const structuredData = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: socialImageURL.toString(),
      url: canonicalURL.toString(),
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      inLanguage: htmlLang ?? SITE.lang ?? "en",
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
      author: {
        "@type": "Person",
        name: author,
        ...(profile && { url: profile }),
      },
      publisher: {
        "@type": "Person",
        name: SITE.author,
        ...(SITE.profile && { url: SITE.profile }),
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      url: SITE.website,
      description: SITE.desc,
      inLanguage: htmlLang ?? SITE.lang ?? "en",
      author: {
        "@type": "Person",
        name: SITE.author,
        ...(SITE.profile && { url: SITE.profile }),
      },
    };
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={htmlLang ?? SITE.lang ?? "en"}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {
      hreflangAlternates?.map(alt => (
        <link rel="alternate" hreflang={alt.lang} href={alt.href} />
      ))
    }

    <!-- Pretendard 본문/헤딩 폰트 — 자체 호스팅 (public/fonts/pretendard-1.3.9/)
         jsdelivr 를 쓰다가 옮겼다. 외부 오리진이면 DNS + TCP + TLS 왕복이
         먼저 붙고, 그 CDN 이 죽으면 폰트가 통째로 안 온다. 같은 오리진이면
         HTTP/2 로 문서와 함께 다중화되고 캐시 정책도 우리가 정한다.
         경로에 버전이 박혀 있어 1년 immutable 로 캐시해도 안전하다.
         @font-face 는 전부 font-display: swap 이라 렌더를 막지 않는다. -->
    <link rel="stylesheet" href="/fonts/pretendard-1.3.9/pretendard.css" />

    <!-- 코드 폰트. preload 하지 않는다 — LCP 요소(h1)는 Pretendard 로 그려지는데,
         코드 폰트를 미리 받으면 임계 구간에서 대역폭을 나눠 갖는다. -->
    <Font cssVariable="--font-google-sans-code" />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }
    {
      // If PUBLIC_NAVER_SITE_VERIFICATION is set in the environment variable,
      // include naver-site-verification tag in the heading.
      // Naver Search Advisor: https://searchadvisor.naver.com/
      PUBLIC_NAVER_SITE_VERIFICATION && (
        <meta
          name="naver-site-verification"
          content={PUBLIC_NAVER_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>

    <!--
      방문 비콘 (2026-10-02~).

      nginx 로그만으로는 사람과 봇이 안 갈린다 — 로그는 "서버에 도착한 요청" 을
      세기 때문에 봇도 전부 들어온다. 이 비콘은 "페이지를 띄우고 JS 를 돌린 것"
      만 센다. 봇은 대부분 JS 를 실행하지 않으므로 추측이 필요 없다.
      (Vercel Analytics 가 쓰던 방식이고, 그래서 그쪽 숫자가 사람에 가까웠다)

      서버는 204 만 돌려주고 nginx 가 beacon.log 에 한 줄 적는다. 보내는 것은
      경로 하나뿐이다 — 쿠키도 식별자도 없다.
    -->
    <script is:inline>
      (function () {
        let last = null;

        function ping() {
          try {
            const p = location.pathname;
            // 대시보드 자신은 세지 않는다
            if (p.indexOf("/stats") === 0) return;
            // 같은 경로를 연달아 보내지 않는다. 아래에서 즉시 한 번 부르고
            // astro:page-load 도 듣는데, ClientRouter 는 첫 로드에서도 그
            // 이벤트를 쏘기 때문에 첫 페이지가 두 번 세어진다.
            if (p === last) return;
            last = p;

            // 경로를 쿼리가 아니라 URL 경로에 붙인다. 쿼리로 보내면 nginx
            // 쪽에서 디코딩이 안 된 날값($arg_p)을 받게 돼 검증이 안 된다.
            const url = "/b" + p;
            if (navigator.sendBeacon) navigator.sendBeacon(url);
            else new Image().src = url;
          } catch {
            /* 통계가 페이지를 망가뜨리면 안 된다 */
          }
        }

        // 즉시 한 번 — ClientRouter 가 없거나 실패해도 세어진다
        ping();
        // 그리고 이후의 화면 이동마다 (전체 새로고침이 아니라 못 잡힌다)
        document.addEventListener("astro:page-load", ping);
      })();
    </script>
  </body>
</html>
