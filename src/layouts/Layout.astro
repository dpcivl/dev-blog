---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  PUBLIC_GOOGLE_SITE_VERIFICATION,
  PUBLIC_NAVER_SITE_VERIFICATION,
} from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";

type HreflangAlt = { lang: string; href: string };

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  noIndex?: boolean;
  noBeacon?: boolean;
  htmlLang?: string;
  hreflangAlternates?: HreflangAlt[];
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, SITE.website),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  noIndex = false,
  noBeacon = false,
  htmlLang,
  hreflangAlternates,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);

// Emit BlogPosting schema only on actual post pages (identified by pubDatetime).
// Other pages get WebSite schema, which is cleaner for the site root and
// avoids Google flagging non-article pages as articles.
const structuredData = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: socialImageURL.toString(),
      url: canonicalURL.toString(),
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      inLanguage: htmlLang ?? SITE.lang ?? "en",
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
      author: {
        "@type": "Person",
        name: author,
        ...(profile && { url: profile }),
      },
      publisher: {
        "@type": "Person",
        name: SITE.author,
        ...(SITE.profile && { url: SITE.profile }),
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      url: SITE.website,
      description: SITE.desc,
      inLanguage: htmlLang ?? SITE.lang ?? "en",
      author: {
        "@type": "Person",
        name: SITE.author,
        ...(SITE.profile && { url: SITE.profile }),
      },
    };
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={htmlLang ?? SITE.lang ?? "en"}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {/* 404 는 방문 통계에서 뺀다 — 없는 주소를 두드린 건 읽은 게 아니다 */}
    {noBeacon && <meta name="x-beacon" content="off" />}

    {
      hreflangAlternates?.map(alt => (
        <link rel="alternate" hreflang={alt.lang} href={alt.href} />
      ))
    }

    <!-- Pretendard 본문/헤딩 폰트 — 자체 호스팅 (public/fonts/pretendard-1.3.9/)
         jsdelivr 를 쓰다가 옮겼다. 외부 오리진이면 DNS + TCP + TLS 왕복이
         먼저 붙고, 그 CDN 이 죽으면 폰트가 통째로 안 온다. 같은 오리진이면
         HTTP/2 로 문서와 함께 다중화되고 캐시 정책도 우리가 정한다.
         경로에 버전이 박혀 있어 1년 immutable 로 캐시해도 안전하다.
         @font-face 는 전부 font-display: swap 이라 렌더를 막지 않는다. -->
    <link rel="stylesheet" href="/fonts/pretendard-1.3.9/pretendard.css" />

    <!-- 코드 폰트. preload 하지 않는다 — LCP 요소(h1)는 Pretendard 로 그려지는데,
         코드 폰트를 미리 받으면 임계 구간에서 대역폭을 나눠 갖는다. -->
    <Font cssVariable="--font-google-sans-code" />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }
    {
      // If PUBLIC_NAVER_SITE_VERIFICATION is set in the environment variable,
      // include naver-site-verification tag in the heading.
      // Naver Search Advisor: https://searchadvisor.naver.com/
      PUBLIC_NAVER_SITE_VERIFICATION && (
        <meta
          name="naver-site-verification"
          content={PUBLIC_NAVER_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>

    <!--
      방문 비콘 (2026-10-02~).

      nginx 로그만으로는 사람과 봇이 안 갈린다 — 로그는 "서버에 도착한 요청" 을
      세기 때문에 봇도 전부 들어온다. 이 비콘은 "페이지를 띄우고 JS 를 돌린 것"
      만 센다. 봇은 대부분 JS 를 실행하지 않으므로 추측이 필요 없다.
      (Vercel Analytics 가 쓰던 방식이고, 그래서 그쪽 숫자가 사람에 가까웠다)

      서버는 204 만 돌려주고 nginx 가 beacon.log 에 한 줄 적는다. 보내는 것은
      경로 하나뿐이다 — 쿠키도 식별자도 없다.
    -->
    <script is:inline>
      (function () {
        let last = null;

        // 이 탭이 어디서 왔나 (2026-10-18~). 비콘 요청의 Referer 는 페이지
        // 자신(parkhyo.in)이라 그것만 적던 때는 유입 경로가 전부 parkhyo.in 이었다.
        // 그래서 페이지가 아는 출처를 따로 실어 보낸다.
        //
        // 탭을 처음 열 때 한 번만 정한다. ClientRouter 로 이동하면
        // document.referrer 가 첫 값 그대로 남고, 블로그 안에서 새로고침하면
        // parkhyo.in 이 된다 — 둘 다 「어디서 왔나」가 아니다. 그래서 X 에서 와서
        // 글 세 편을 읽으면 세 편 다 X 로 센다. 쿠키가 아니라 탭이 닫히면
        // 사라지는 sessionStorage 다.
        function entryRef() {
          try {
            let r = sessionStorage.getItem("b:ref");
            if (r === null) {
              const d = document.referrer;
              const inside =
                d && /(^|\.)parkhyo\.in$/.test(new URL(d).hostname);
              // 헤더에는 ASCII 만 실을 수 있다. URL 은 원래 인코딩돼 있지만 혹시
              // 모를 글자 하나 때문에 비콘 전체가 죽지 않게 걸러둔다
              r =
                d && !inside
                  ? d.replace(/[^\x20-\x7e]/g, "").slice(0, 300)
                  : "";
              sessionStorage.setItem("b:ref", r);
            }
            return r;
          } catch {
            return "";
          }
        }

        function send(url) {
          const ref = entryRef();
          // 출처는 헤더로 보낸다. sendBeacon 은 헤더를 못 단다.
          // 같은 출처 요청이라 사전 요청(CORS)도 없다.
          if (window.fetch) {
            fetch(url, {
              method: "POST",
              keepalive: true,
              credentials: "omit",
              headers: ref ? { "X-Ref": ref } : {},
            }).catch(() => {});
          } else if (navigator.sendBeacon) navigator.sendBeacon(url);
          else new Image().src = url;
        }

        function ping() {
          try {
            const p = location.pathname;
            // 대시보드 자신은 세지 않는다
            if (p.indexOf("/stats") === 0) return;
            // 404 는 세지 않는다. 주소 형태만 보면 /posts/x/ 같은 탐색 요청이
            // 글 페이지와 구별이 안 되므로, 없는 글이라는 사실을 아는 여기서
            // 끊는다. ClientRouter 가 head 까지 갈아끼우므로 이동 후에도 맞다.
            if (document.querySelector('meta[name="x-beacon"][content="off"]'))
              return;
            // 같은 경로를 연달아 보내지 않는다. 아래에서 즉시 한 번 부르고
            // astro:page-load 도 듣는데, ClientRouter 는 첫 로드에서도 그
            // 이벤트를 쏘기 때문에 첫 페이지가 두 번 세어진다.
            if (p === last) return;
            last = p;

            // 경로를 쿼리가 아니라 URL 경로에 붙인다. 쿼리로 보내면 nginx
            // 쪽에서 디코딩이 안 된 날값($arg_p)을 받게 돼 검증이 안 된다.
            send("/b" + p);
          } catch {
            /* 통계가 페이지를 망가뜨리면 안 된다 */
          }
        }

        // 즉시 한 번 — ClientRouter 가 없거나 실패해도 세어진다
        ping();
        // 그리고 이후의 화면 이동마다 (전체 새로고침이 아니라 못 잡힌다)
        document.addEventListener("astro:page-load", ping);
      })();
    </script>
  </body>
</html>
