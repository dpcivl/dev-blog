---
// 홈 히어로 — 찾고 싶은 것을 적으면 주제 카드와 글을 바로 보여준다.
//
// 공공데이터포털처럼 "묻는 자리" 가 홈의 중심이 되게 했다. 다만 기존 메뉴와
// 아래 글 목록은 걷지 않는다. 홈은 검색엔진이 제일 많이 읽는 페이지라
// 입력창만 남기면 가져갈 내용이 사라지고, 채용 담당자가 들어왔을 때도
// 대화창 하나보다 글 목록이 먼저 보이는 편이 낫다.
//
// 두 군데를 뒤진다. 둘 다 서버를 안 거친다.
//   1. 주제 표 (src/data/topics.ts) — 포트폴리오 · 시리즈 · 주요 페이지.
//      Pagefind 가 블로그 글만 색인하므로 그 바깥은 여기가 담당한다.
//   2. Pagefind — 블로그 글 본문. 빌드 때 만든 정적 인덱스.
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { getSeriesSummary } from "@/data/series";
import { filterByLang } from "@/utils/i18n";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { TOPICS, type Topic } from "@/data/topics";

// 검색이 아니라 "목록" 이 답인 질문들이 있다. 최신 글 · 블로그 구성 · 포트폴리오
// 전체가 그렇다. Pagefind 로는 안 되고 주제 표에 손으로 적어둘 수도 없다 —
// 글이 늘 때마다 갈라진다. 그래서 빌드할 때 실제 데이터로 만든다.
const koPosts = getSortedPosts(filterByLang(await getCollection("blog"), "ko"));
const seriesSummary = getSeriesSummary(
  filterByLang(await getCollection("blog"), "ko")
);
const portfolio = (await getCollection("portfolio")).sort(
  (a, b) => (b.data.order ?? 0) - (a.data.order ?? 0)
);

const fmtDate = (d: Date | string) => {
  const x = new Date(d);
  return `${x.getFullYear()}.${String(x.getMonth() + 1).padStart(2, "0")}.${String(x.getDate()).padStart(2, "0")}`;
};

const firstPost = koPosts[koPosts.length - 1];
const lastPost = koPosts[0];

const DYNAMIC: Topic[] = [
  {
    id: "recent",
    kind: "페이지",
    title: "최신 글",
    summary: `가장 최근에 올린 글부터 다섯 편. 전체 ${koPosts.length}편은 아카이브에 있다.`,
    href: "/archives",
    meta: lastPost
      ? `최근 발행 ${fmtDate(lastPost.data.pubDatetime)}`
      : undefined,
    aliases: ["최신", "최신글", "최근", "최근글", "새글", "요즘", "업데이트"],
    items: koPosts.slice(0, 5).map(p => ({
      title: p.data.title,
      desc: p.data.description,
      href: `${getPath(p.id, p.filePath)}/`,
    })),
  },
  {
    id: "overview",
    kind: "페이지",
    title: "이 블로그는 어떤 글로 되어 있나",
    summary:
      `${firstPost ? fmtDate(firstPost.data.pubDatetime) : ""}부터 ${koPosts.length}편. ` +
      `한 주제를 여러 편으로 나눈 시리즈가 ${seriesSummary.length}개이고, ` +
      `나머지는 그때그때 막힌 것을 남긴 단발 기록이다.`,
    href: "/series",
    // "블로그구성" 은 통째로 일치시키려고 둔다. 줄여서 "블로그 구성" 이라고
    // 물으면 낱말이 "블로그" + "구성" 으로 갈리면서 포트폴리오의
    // 「개인 블로그 인프라」가 먼저 걸린다.
    aliases: [
      "블로그구성",
      "구성",
      "구성되어",
      "어떤글",
      "어떤글로",
      "무슨글",
      "주제",
      "통계",
      "시리즈",
    ],
    items: seriesSummary.map(sr => ({
      title: `${sr.title} · ${sr.count}편`,
      desc: sr.description,
      href: `/series#${sr.id}`,
    })),
  },
  {
    id: "portfolio",
    kind: "페이지",
    title: "포트폴리오",
    summary:
      "직접 만들고 배포한 것들. 접속 가능한 사이트가 있는 프로젝트만 올린다.",
    href: "/portfolio",
    meta: `${portfolio.length}개`,
    aliases: [
      "포트폴리오",
      "portfolio",
      "프로젝트",
      "만든것",
      "만든거",
      "작업물",
      "제품",
    ],
    items: portfolio.map(pr => ({
      title: pr.data.title,
      desc: pr.data.period,
      href: `/portfolio#${pr.id}`,
    })),
  },
];

// 태그도 주제로 넣는다. "RAG 관련 글" 처럼 주제어 하나만 던지는 질문이
// 제일 흔한데, 그때 글 목록만 나오는 것보다 "이 태그에 N편" 이 먼저 보이는
// 편이 답에 가깝다. 두 편 이하인 태그는 뺀다 — 169개를 다 넣으면 잡음이 된다.
const tagCount = new Map<string, { name: string; posts: typeof koPosts }>();
for (const post of koPosts) {
  for (const raw of post.data.tags ?? []) {
    const key = slugifyStr(raw);
    if (!tagCount.has(key)) tagCount.set(key, { name: raw, posts: [] });
    tagCount.get(key)!.posts.push(post);
  }
}

const TAG_TOPICS: Topic[] = [...tagCount.entries()]
  .filter(([, v]) => v.posts.length >= 3)
  .sort((a, b) => b[1].posts.length - a[1].posts.length)
  .map(([slug, v]) => ({
    id: `tag-${slug}`,
    kind: "태그" as const,
    title: `#${v.name}`,
    summary: `이 태그가 붙은 글 ${v.posts.length}편.`,
    href: `/tags/${slug}/`,
    meta: `${v.posts.length}편`,
    aliases: [v.name, slug],
    items: v.posts.slice(0, 5).map(pp => ({
      title: pp.data.title,
      desc: pp.data.description,
      href: `${getPath(pp.id, pp.filePath)}/`,
    })),
  }));

// 동적인 것을 앞에 둔다 — 같은 점수면 먼저 걸린 쪽이 위로 온다
const ALL_TOPICS: Topic[] = [...DYNAMIC, ...TAG_TOPICS, ...TOPICS];

// 추천 질문. 보여주는 문장과 실제로 던지는 말을 나눈다 — 지금 검색은 낱말
// 기준이라 문장을 그대로 넣으면 잘 안 맞는다. LLM 을 붙이면 q 를 지우면 된다.
const SUGGESTIONS = [
  { label: "최신 글 목록 보여주세요.", q: "최신 글" },
  { label: "이 블로그는 어떤 글로 구성되어 있나요?", q: "블로그 구성" },
  { label: "RAG 관련 글", q: "RAG" },
  { label: "포트폴리오 보여주세요.", q: "포트폴리오" },
  { label: "Park Hyoin에 대해 소개해주세요.", q: "박효인 소개" },
];
---

<section class="ask-hero" data-ask>
  <div class="ask-head">
    <p class="ask-eyebrow">박효인 · PARK HYOIN</p>

    <h1 class="ask-title">
      만든 것과 <span class="hl">막힌 것</span>을 그때그때 기록합니다.
    </h1>
  </div>

  <div class="ask-box">
    <label class="sr-only" for="ask-input">무엇을 찾으시나요</label>
    <textarea
      id="ask-input"
      rows="2"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      placeholder="무엇을 찾으시나요?"></textarea>
    <button type="button" class="ask-go" data-ask-go aria-label="찾기">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5"></path>
        <path d="m5 12 7-7 7 7"></path>
      </svg>
    </button>
  </div>

  <ul class="ask-suggest">
    {
      SUGGESTIONS.map(s => (
        <li>
          <button type="button" class="sug" data-q={s.q}>
            <svg
              class="sug-mark"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 2.5 13.9 9 20.5 11 13.9 13 12 19.5 10.1 13 3.5 11 10.1 9z" />
              <path d="M18.5 2.5 19.4 5.1 22 6l-2.6.9-.9 2.6-.9-2.6L15 6l2.6-.9z" />
            </svg>
            <span>“{s.label}”</span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="ask-answer" data-ask-answer hidden>
    <div class="ask-answer-head">
      <p class="ask-q">
        <span class="ask-q-label">찾은 것</span>
        <strong data-ask-echo></strong>
      </p>
      <button type="button" class="ask-reset" data-ask-reset>
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        처음으로
      </button>
    </div>
    <div class="ask-results" data-ask-results aria-live="polite"></div>
  </div>
</section>

<script define:vars={{ TOPICS: ALL_TOPICS }}>
  (() => {
    const root = document.querySelector("[data-ask]");
    if (!root) return;

    const input = root.querySelector("#ask-input");
    const panel = root.querySelector("[data-ask-results]");
    const goBtn = root.querySelector("[data-ask-go]");
    const answer = root.querySelector("[data-ask-answer]");
    const echo = root.querySelector("[data-ask-echo]");
    const resetBtn = root.querySelector("[data-ask-reset]");

    // 검색 전/후를 화면으로 구분한다. 결과가 추천 질문 밑에 그냥 붙으면
    // 검색이 됐는지조차 안 보인다.
    function setAnswered(on, query) {
      root.classList.toggle("is-answered", on);
      answer.hidden = !on;
      if (on) echo.textContent = `“${query}”`;
    }

    // 글자와 숫자만 남긴다. "parkhyo.in" 과 "parkhyo in" 이 같아진다.
    const norm = s => s.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "");
    const esc = s =>
      String(s).replace(
        /[&<>"']/g,
        c =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]
      );

    // ── 주제 표 ──
    // 낱말 단위까지 보는 게 핵심이다. "이 블로그는 어떤 글로 구성되어 있나요?"
    // 처럼 문장으로 물으면 통째로는 어떤 별칭과도 안 맞는다. 조사를 떼고
    // 쪼개야 "구성되어" 가 「구성」 에 닿는다.
    const PARTICLE = /[은는이가을를의에서로와과도만]$/u;
    function tokenize(query) {
      return query
        .split(/[\s,.?!·…"'“”‘’()[\]]+/)
        .map(w => w.replace(PARTICLE, "") || w)
        .map(norm)
        .filter(w => w.length >= 2);
    }

    function findTopics(query, limit = 3) {
      const q = norm(query);
      if (q.length < 2) return [];
      const words = tokenize(query);
      const scored = [];

      for (const t of TOPICS) {
        const keys = [norm(t.id), norm(t.title), ...t.aliases.map(norm)].filter(
          k => k.length >= 2
        );
        // 점수와 길이를 "가장 잘 맞은 별칭 하나" 기준으로 같이 잡는다.
        // 따로 최대값을 취하면, 약하게 걸린 긴 별칭의 길이가 강하게 걸린
        // 짧은 별칭에 얹혀서 순위가 뒤집힌다.
        let score = 0;
        let len = 0;
        for (const k of keys) {
          let sc = 0;
          if (k === q) sc = 3;
          else if (words.includes(k)) sc = 2;
          else if (k.includes(q) || q.includes(k)) sc = 1;
          else if (words.some(w => w.includes(k) || k.includes(w))) sc = 1;
          if (sc > score || (sc === score && sc > 0 && k.length > len)) {
            score = sc;
            len = k.length;
          }
        }
        if (score > 0) scored.push({ t, score, len });
      }

      scored.sort((a, b) => b.score - a.score || b.len - a.len);
      // 1등보다 확실히 약한 것은 버린다. 곁다리 카드가 답을 흐린다
      const top = scored[0]?.score ?? 0;
      const kept = [];
      const names = new Set();
      for (const x of scored) {
        if (x.score < top - 1 || (top === 3 && x.score < 3)) continue;
        // 「포트폴리오」와 「#포트폴리오」가 나란히 뜨면 같은 말을 두 번 한다
        const name = norm(x.t.title.replace(/^#/, ""));
        if (names.has(name)) continue;
        names.add(name);
        kept.push(x.t);
        if (kept.length >= limit) break;
      }
      return kept;
    }

    // ── Pagefind (빌드 결과물이라 dev 에서는 없을 수 있다) ──
    let pagefind = null;
    let pagefindFailed = false;
    async function getPagefind() {
      if (pagefind || pagefindFailed) return pagefind;
      try {
        pagefind = await import(/* @vite-ignore */ "/pagefind/pagefind.js");
        await pagefind.options({ excerptLength: 24 });
        return pagefind;
      } catch {
        pagefindFailed = true;
        return null;
      }
    }

    // Pagefind 가 진짜로 맞춘 것인지 본다.
    //
    // 점수로는 못 가른다 — "zzzzz"(4.85)가 "julgot"(3.92)보다 높게 나온다.
    // Pagefind 가 질의를 쪼개서 조각까지 맞추기 때문이다. 실제로 "asdfqwer" 는
    // "LLM-as-Judge" 의 as 에, "zzzzz" 는 코드 예제의 'z' 에 걸렸다.
    //
    // 대신 발췌의 <mark> 를 본다. Pagefind 가 "무엇을 맞췄다고 보는지" 가
    // 거기 표시된다. 표시된 말이 질의를 품거나 질의의 상당 부분이어야 통과시킨다.
    function matched(query, excerpt) {
      const q = norm(query);
      if (!q) return false;
      const marks = [...excerpt.matchAll(/<mark>(.*?)<\/mark>/g)].map(m =>
        norm(m[1])
      );
      const min = Math.max(2, Math.ceil(q.length * 0.6));
      return marks.some(
        m =>
          m.length >= 2 && (m.includes(q) || (q.includes(m) && m.length >= min))
      );
    }

    // 문장으로 물었을 때를 위한 낱말 뽑기.
    // "julgot 은 어떤 앱인가요?" 를 통째로 던지면 안 맞으니 긴 낱말부터 다시 던진다.
    const STOP = new Set([
      "무엇",
      "뭐",
      "어떤",
      "어떻게",
      "알려줘",
      "알려주세요",
      "있나요",
      "있어요",
      "인가요",
      "관련",
      "대해",
      "대한",
      "정보",
      "내용",
      "그리고",
      "해줘",
      "보여줘",
      "찾아줘",
      "포스트",
      "방법",
    ]);
    function keywords(query) {
      return query
        .split(/[\s,.?!·…"'“”‘’()[\]]+/)
        .map(w => w.replace(/[은는이가을를의에서로와과도만]$/u, "") || w)
        .filter(w => norm(w).length >= 2 && !STOP.has(w))
        .sort((a, b) => norm(b).length - norm(a).length)
        .slice(0, 3);
    }

    async function runPagefind(term, limit) {
      const pf = await getPagefind();
      if (!pf) return null;
      const res = await pf.search(term);
      const rows = await Promise.all(
        res.results.slice(0, limit * 3).map(r => r.data())
      );
      return rows
        .filter(d => matched(term, d.excerpt ?? ""))
        .map(d => ({
          title: d.meta?.title ?? d.url,
          url: d.url.replace(/\.html$/, ""),
          excerpt: d.excerpt ?? "",
        }));
    }

    async function searchPosts(query, limit = 5) {
      const direct = await runPagefind(query, limit);
      if (direct === null) return null; // 인덱스 없음 — 못 찾은 것과 구분한다
      if (direct.length) return direct;

      // 통째로 안 맞으면 낱말로 다시 — 문장으로 물었을 때를 위해
      const seen = new Set();
      const merged = [];
      for (const w of keywords(query)) {
        const rows = await runPagefind(w, limit);
        for (const r of rows ?? []) {
          if (seen.has(r.url)) continue;
          seen.add(r.url);
          merged.push(r);
        }
        if (merged.length >= limit) break;
      }
      return merged;
    }

    // ── 그리기 ──
    const topicItem = it => `
      <a class="ask-item" href="${esc(it.href)}">
        <span class="ask-item-title">${esc(it.title)}</span>
        ${it.desc ? `<span class="ask-item-desc">${esc(it.desc)}</span>` : ""}
      </a>`;

    // 목록이 있는 주제는 카드 전체를 링크로 감싸지 않는다 — 안에 링크가 들어간다
    const topicCard = t => {
      const head = `
        <div class="ask-card-head">
          <span class="ask-kind">${esc(t.kind)}</span>
          ${t.meta ? `<span class="ask-meta">${esc(t.meta)}</span>` : ""}
        </div>`;
      const body = `
        <div class="ask-card-title">${esc(t.title)}</div>
        <p class="ask-card-desc">${esc(t.summary)}</p>`;

      if (!t.items?.length) {
        return `<a class="ask-card" href="${esc(t.href)}">${head}${body}</a>`;
      }
      return `<div class="ask-card is-list">
        ${head}
        <a class="ask-card-link" href="${esc(t.href)}">${body}</a>
        <div class="ask-items">${t.items.map(topicItem).join("")}</div>
      </div>`;
    };

    const postRow = p => `
      <a class="ask-row" href="${esc(p.url)}">
        <span class="ask-row-title">${esc(p.title)}</span>
        <span class="ask-row-excerpt">${p.excerpt}</span>
      </a>`;

    function render(query, topics, posts) {
      if (!query) {
        setAnswered(false);
        panel.innerHTML = "";
        return;
      }
      setAnswered(true, query);

      let html = "";
      if (topics.length) {
        html += `<div class="ask-cards">${topics.map(topicCard).join("")}</div>`;
      }

      if (posts === null) {
        html += `<p class="ask-note">검색 인덱스를 못 불러왔습니다. <code>pnpm build</code> 를 한 번 돌리면 생깁니다.</p>`;
      } else if (posts.length) {
        const shown = posts.slice(0, 5);
        html += `<div class="ask-section">글 ${shown.length}편</div>`;
        html += `<div class="ask-rows">${shown.map(postRow).join("")}</div>`;
        html += `<a class="ask-more" href="/search?q=${encodeURIComponent(query)}">검색 페이지에서 더 보기 →</a>`;
      } else if (!topics.length) {
        html = `<p class="ask-note">“${esc(query)}” 로 찾은 게 없습니다. 다른 말로 해보시거나 <a href="/archives">전체 글</a>을 보세요.</p>`;
      }

      panel.innerHTML = html;
    }

    // ── 입력 처리 ──
    let timer;
    let seq = 0;

    async function run(query) {
      const q = query.trim();
      if (!q) return render("", [], []);

      const mine = ++seq;
      const topics = findTopics(q);
      render(q, topics, []); // 주제는 즉시, 글은 오는 대로
      const posts = await searchPosts(q);
      if (mine === seq) render(q, topics, posts);
    }

    // 추천을 눌렀을 때는 결과가 화면에 들어오게 한다
    function runAndReveal(query) {
      clearTimeout(timer);
      run(query).then(() => {
        // 결과가 아니라 히어로 위쪽으로 맞춘다. 결과에 맞추면 입력창이
        // 화면 밖으로 밀려서 고쳐 묻기가 어려워진다.
        root.scrollIntoView({ block: "start", behavior: "smooth" });
      });
    }

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => run(input.value), 200);
    });

    input.addEventListener("keydown", e => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        runAndReveal(input.value);
      }
      if (e.key === "Escape") {
        input.value = "";
        run("");
        input.blur();
      }
    });

    resetBtn.addEventListener("click", () => {
      input.value = "";
      render("", [], []);
      input.focus();
      root.scrollIntoView({ block: "start", behavior: "smooth" });
    });

    goBtn.addEventListener("click", () => {
      clearTimeout(timer);
      run(input.value);
      input.focus();
    });

    root.querySelectorAll("[data-q]").forEach(btn => {
      btn.addEventListener("click", () => {
        input.value = btn.dataset.q;
        runAndReveal(input.value);
      });
    });

    // ?q= 로 들어오면 바로 채워준다 (검색 페이지에서 되돌아올 때)
    const q0 = new URLSearchParams(location.search).get("q");
    if (q0) {
      input.value = q0;
      run(q0);
    }
  })();
</script>

