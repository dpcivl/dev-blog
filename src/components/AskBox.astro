---
// 홈 입력창 — 찾고 싶은 것을 적으면 주제 카드와 글을 바로 보여준다.
//
// 두 군데를 뒤진다.
//   1. 주제 표 (src/data/topics.ts) — 포트폴리오 · 시리즈 · 주요 페이지.
//      Pagefind 가 블로그 글만 색인하므로 그 바깥은 여기가 담당한다.
//   2. Pagefind — 블로그 글 본문. 정적 인덱스라 서버를 안 거친다.
//
// 기존 메뉴와 글 목록은 그대로 둔다. 이 입력창은 그 위에 얹히는 것이지
// 대신하는 것이 아니다. 검색엔진이 홈에서 가져갈 내용도 아래에 남아 있어야 한다.
import { TOPICS } from "@/data/topics";

// 추천 칩 — 빈 입력창은 무엇을 물어야 할지 알려주지 않는다.
const SUGGESTIONS = ["포트폴리오", "julgot", "LLM 공부", "이 블로그", "검증"];
---

<section class="ask" data-ask>
  <label class="ask-label" for="ask-input">무엇을 찾으시나요</label>

  <div class="ask-field">
    <svg
      class="ask-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      id="ask-input"
      type="search"
      autocomplete="off"
      enterkeyhint="search"
      placeholder="포트폴리오, julgot, 검증 …"
      aria-describedby="ask-hint"
    />
    <button
      type="button"
      class="ask-clear"
      data-ask-clear
      hidden
      aria-label="지우기">&times;</button
    >
  </div>

  <p id="ask-hint" class="ask-hint">
    {
      SUGGESTIONS.map(s => (
        <button type="button" class="chip" data-chip={s}>
          {s}
        </button>
      ))
    }
  </p>

  <div class="ask-results" data-ask-results aria-live="polite" hidden></div>
</section>

<script define:vars={{ TOPICS }}>
  (() => {
    const root = document.querySelector("[data-ask]");
    if (!root) return;

    const input = root.querySelector("#ask-input");
    const panel = root.querySelector("[data-ask-results]");
    const clearBtn = root.querySelector("[data-ask-clear]");

    // 글자와 숫자만 남긴다. "parkhyo.in" 과 "parkhyo in" 이 같아진다.
    const norm = s => s.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "");

    // Pagefind 가 진짜로 맞춘 것인지 본다.
    //
    // 점수로는 못 가른다 — "zzzzz"(4.85)가 "julgot"(3.92)보다 높게 나온다.
    // Pagefind 가 질의를 쪼개서 조각까지 맞추기 때문이다. 실제로 "asdfqwer" 는
    // "LLM-as-Judge" 의 as 에, "zzzzz" 는 코드 예제의 'z' 에 걸렸다.
    //
    // 대신 발췌의 <mark> 를 본다. Pagefind 가 "무엇을 맞췄다고 보는지" 가
    // 거기 표시된다. 표시된 말이 질의를 품거나, 질의의 상당 부분이어야 통과시킨다.
    function matched(query, excerpt) {
      const q = norm(query);
      if (!q) return false;
      const marks = [...excerpt.matchAll(/<mark>(.*?)<\/mark>/g)].map(m =>
        norm(m[1])
      );
      const min = Math.max(2, Math.ceil(q.length * 0.6));
      return marks.some(
        m =>
          m.length >= 2 && (m.includes(q) || (q.includes(m) && m.length >= min))
      );
    }
    const esc = s =>
      String(s).replace(
        /[&<>"']/g,
        c =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]
      );

    // ── 주제 표 (서버에서 그대로 넘겨받는다) ──
    function findTopics(query, limit = 3) {
      const q = norm(query);
      if (q.length < 2) return [];
      const exact = [];
      const partial = [];
      for (const t of TOPICS) {
        const keys = [norm(t.id), norm(t.title), ...t.aliases.map(norm)];
        if (keys.some(k => k === q)) exact.push(t);
        else if (keys.some(k => k.includes(q) || q.includes(k)))
          partial.push(t);
      }
      return [...exact, ...partial].slice(0, limit);
    }

    // ── Pagefind (빌드 결과물이라 dev 에서는 없을 수 있다) ──
    let pagefind = null;
    let pagefindFailed = false;
    async function getPagefind() {
      if (pagefind || pagefindFailed) return pagefind;
      try {
        pagefind = await import(/* @vite-ignore */ "/pagefind/pagefind.js");
        await pagefind.options({ excerptLength: 24 });
        return pagefind;
      } catch {
        pagefindFailed = true;
        return null;
      }
    }

    async function searchPosts(query, limit = 5) {
      const pf = await getPagefind();
      if (!pf) return null; // 인덱스 없음 — 못 찾은 것과 구분한다
      const res = await pf.search(query);
      // 거르고 나면 줄어드니 넉넉히 받아온다
      const rows = await Promise.all(
        res.results.slice(0, limit * 3).map(r => r.data())
      );
      return rows
        .filter(d => matched(query, d.excerpt ?? ""))
        .map(d => ({
          title: d.meta?.title ?? d.url,
          url: d.url.replace(/\.html$/, ""),
          excerpt: d.excerpt ?? "",
        }));
    }

    // ── 그리기 ──
    const topicCard = t => `
      <a class="ask-card" href="${esc(t.href)}">
        <div class="ask-card-head">
          <span class="ask-kind">${esc(t.kind)}</span>
          ${t.meta ? `<span class="ask-meta">${esc(t.meta)}</span>` : ""}
        </div>
        <div class="ask-card-title">${esc(t.title)}</div>
        <p class="ask-card-desc">${esc(t.summary)}</p>
      </a>`;

    const postRow = p => `
      <a class="ask-row" href="${esc(p.url)}">
        <span class="ask-row-title">${esc(p.title)}</span>
        <span class="ask-row-excerpt">${p.excerpt}</span>
      </a>`;

    function render(query, topics, posts) {
      if (!query) {
        panel.hidden = true;
        panel.innerHTML = "";
        return;
      }

      let html = "";
      if (topics.length) {
        html += `<div class="ask-cards">${topics.map(topicCard).join("")}</div>`;
      }

      if (posts === null) {
        html += `<p class="ask-note">검색 인덱스를 못 불러왔습니다. <code>pnpm build</code> 를 한 번 돌리면 생깁니다.</p>`;
      } else if (posts.length) {
        html += `<div class="ask-section">글 ${Math.min(posts.length, 5)}편</div>`;
        html += `<div class="ask-rows">${posts.slice(0, 5).map(postRow).join("")}</div>`;
        html += `<a class="ask-more" href="/search?q=${encodeURIComponent(query)}">검색 페이지에서 더 보기 →</a>`;
      } else if (!topics.length) {
        html = `<p class="ask-note">"${esc(query)}" 로 찾은 게 없습니다. 다른 말로 해보시거나 <a href="/archives">전체 글</a>을 보세요.</p>`;
      }

      panel.innerHTML = html;
      panel.hidden = false;
    }

    // ── 입력 처리 ──
    let timer;
    let seq = 0;

    async function run(query) {
      const q = query.trim();
      clearBtn.hidden = !q;
      if (!q) return render("", [], []);

      const mine = ++seq;
      const topics = findTopics(q);
      // 주제는 즉시 그리고, 글은 오는 대로 덧붙인다
      render(q, topics, []);
      const posts = await searchPosts(q);
      if (mine === seq) render(q, topics, posts);
    }

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => run(input.value), 180);
    });

    input.addEventListener("keydown", e => {
      if (e.key === "Escape") {
        input.value = "";
        run("");
        input.blur();
      }
    });

    clearBtn.addEventListener("click", () => {
      input.value = "";
      run("");
      input.focus();
    });

    root.querySelectorAll("[data-chip]").forEach(btn => {
      btn.addEventListener("click", () => {
        input.value = btn.dataset.chip;
        input.focus();
        run(input.value);
      });
    });

    // ?q= 로 들어오면 바로 채워준다 (검색 페이지에서 되돌아올 때)
    const q0 = new URLSearchParams(location.search).get("q");
    if (q0) {
      input.value = q0;
      run(q0);
    }
  })();
</script>

<style>
  .ask {
    margin-top: 2.25rem;
  }
  .ask-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .ask-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .ask-field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 16%, transparent);
  }
  .ask-icon {
    flex: none;
    color: var(--muted);
  }
  .ask-field input {
    flex: 1;
    min-width: 0;
    padding: 13px 0;
    border: 0;
    outline: none;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 1rem;
  }
  .ask-field input::-webkit-search-cancel-button {
    display: none;
  }
  .ask-clear {
    flex: none;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 1.3rem;
    line-height: 1;
    padding: 0 2px;
    cursor: pointer;
  }
  .ask-clear:hover {
    color: var(--accent);
  }

  .ask-hint {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0.7rem 0 0;
  }
  .chip {
    padding: 5px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .ask-results {
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 14px;
  }

  :global(.ask-cards) {
    display: grid;
    gap: 10px;
  }
  :global(.ask-card) {
    display: block;
    padding: 13px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s ease;
  }
  :global(.ask-card:hover) {
    background: var(--accent-bg);
  }
  :global(.ask-card-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  :global(.ask-kind) {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  :global(.ask-meta) {
    font-size: 0.72rem;
    color: var(--muted);
  }
  :global(.ask-card-title) {
    font-weight: 600;
    line-height: 1.45;
    margin-top: 4px;
  }
  :global(.ask-card-desc) {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 5px 0 0;
  }

  :global(.ask-section) {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 14px 0 6px;
  }
  :global(.ask-rows) {
    display: flex;
    flex-direction: column;
  }
  :global(.ask-row) {
    display: block;
    padding: 9px 10px;
    margin: 0 -10px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
  }
  :global(.ask-row:hover) {
    background: var(--accent-bg);
  }
  :global(.ask-row-title) {
    display: block;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.45;
  }
  :global(.ask-row-excerpt) {
    display: block;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--muted);
    margin-top: 2px;
  }
  :global(.ask-row-excerpt mark) {
    background: var(--accent-bg);
    color: var(--accent);
    padding: 0 1px;
  }
  :global(.ask-more) {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--accent);
  }
  :global(.ask-note) {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }
  :global(.ask-note a) {
    color: var(--accent);
  }
</style>
