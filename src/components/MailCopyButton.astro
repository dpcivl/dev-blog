---
/**
 * 클릭 시 이메일 주소를 클립보드로 복사하고 토스트를 띄우는 스크립트 + 토스트 마크업.
 * 페이지에 한 번만 넣으면 되고, 동작 대상은 `a[data-mail-copy]` 전체.
 * (기존 Sidebar.astro 의 initSidebarMailCopy 를 일반화해서 분리)
 */
---

<div
  id="mail-copy-toast"
  class="mail-copy-toast"
  role="status"
  aria-live="polite"
>
</div>

<style>
  .mail-copy-toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%) translateY(0.5rem);
    padding: 0.55rem 1.1rem;
    background: var(--foreground);
    color: var(--background);
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.25);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    z-index: 100;
  }
  .mail-copy-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .mail-copy-toast {
      transition: none;
    }
  }
</style>

<script>
  function showMailToast(msg: string) {
    const toast = document.getElementById("mail-copy-toast");
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add("is-visible");
    const existing = (toast as HTMLElement & { _t?: number })._t;
    if (existing) window.clearTimeout(existing);
    (toast as HTMLElement & { _t?: number })._t = window.setTimeout(() => {
      toast.classList.remove("is-visible");
    }, 1800);
  }

  function initMailCopy() {
    const langAttr = document.documentElement.lang;
    const lang: "ko" | "en" = langAttr?.startsWith("en") ? "en" : "ko";
    const copiedMsg =
      lang === "en" ? "Email address copied" : "이메일 주소가 복사됐어요";

    const mailLinks = document.querySelectorAll<HTMLAnchorElement>(
      'a[data-mail-copy][href^="mailto:"]'
    );
    mailLinks.forEach(link => {
      if (link.dataset.bound === "1") return;
      link.dataset.bound = "1";
      link.addEventListener("click", async (e: MouseEvent) => {
        // Ctrl/Cmd+click 은 새 탭 등 native 동작 유지
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

        const href = link.getAttribute("href") ?? "";
        const email = href.replace(/^mailto:/, "").split("?")[0];
        if (!email) return;

        e.preventDefault();
        try {
          await navigator.clipboard.writeText(email);
          showMailToast(copiedMsg);
        } catch {
          // Clipboard 실패 → 원래 mailto 동작으로 폴백
          window.location.href = href;
        }
      });
    });
  }

  initMailCopy();
  document.addEventListener("astro:page-load", initMailCopy);
</script>
