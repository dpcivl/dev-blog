---
import { SITE } from "@/config";

interface Props {
  /** 열 우선(주 단위 7일씩) 일별 발행 편수 */
  data: number[];
  /** data 와 같은 순서의 날짜 (YYYY-MM-DD) — title 툴팁용 */
  dates?: string[];
  total: number;
  /** 발행이 있었던 날짜만 담은 맵 — 클라이언트가 오늘 기준으로 창을 다시 계산한다 */
  counts?: Record<string, number>;
  /** 창 길이(일). 주 단위로 올림된다 */
  days?: number;
  label?: string;
  /** 편수 단위 (KO "편" / EN " posts") */
  unit?: string;
  legendLow?: string;
  legendHigh?: string;
}

const {
  data,
  dates = [],
  total,
  counts = {},
  days = 90,
  label,
  unit = "편",
  legendLow = "적음",
  legendHigh = "많음",
} = Astro.props;

const weeks = Math.ceil(data.length / 7);

/*
 * 0편 / 1편 / 2편 / 3편+ 의 4단계만 쓴다 (lvl 1 은 결번).
 * 범례도 실제로 나타나는 단계와 같은 수로 맞춰야 "안 쓰는 색" 이 생기지 않는다.
 */
const LEVELS = [0, 2, 3, 4] as const;
const level = (n: number) => (n === 0 ? 0 : n === 1 ? 2 : n === 2 ? 3 : 4);

const ariaLabel = label ?? `발행 활동 히트맵: ${weeks}주 동안 총 ${total}${unit}`;
---

<div class="grass-wrap">
  <div
    class="grass"
    role="img"
    aria-label={ariaLabel}
    style={`--weeks:${weeks}`}
    data-grass
    data-counts={JSON.stringify(counts)}
    data-days={days}
    data-unit={unit}
    data-tz={SITE.timezone}
    data-label-tpl={label ? "en" : "ko"}
  >
    {
      data.map((n, i) => (
        <div
          class="grass-cell"
          data-lvl={level(n)}
          title={dates[i] ? `${dates[i]} · ${n}${unit}` : `${n}${unit}`}
          aria-hidden="true"
        />
      ))
    }
  </div>
  <div class="grass-legend">
    <span>{legendLow}</span>
    {
      LEVELS.map(l => (
        <span class="grass-cell" data-lvl={l} aria-hidden="true" />
      ))
    }
    <span>{legendHigh}</span>
  </div>
</div>

<style>
  .grass-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .grass {
    display: grid;
    grid-template-rows: repeat(7, 10px);
    grid-auto-flow: column;
    grid-auto-columns: 10px;
    gap: 3px;
    justify-content: start;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .grass-cell {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    flex: none;
  }
  .grass-cell[data-lvl="0"] {
    background: color-mix(in oklab, var(--border) 70%, var(--background));
  }
  .grass-cell[data-lvl="1"] {
    background: color-mix(in oklab, var(--accent) 20%, var(--background));
  }
  .grass-cell[data-lvl="2"] {
    background: color-mix(in oklab, var(--accent) 40%, var(--background));
  }
  .grass-cell[data-lvl="3"] {
    background: color-mix(in oklab, var(--accent) 68%, var(--background));
  }
  .grass-cell[data-lvl="4"] {
    background: var(--accent);
  }
  .grass-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .grass-legend > span:first-child {
    margin-right: 0.35rem;
  }
  .grass-legend > span:last-child {
    margin-left: 0.35rem;
  }
</style>

<script>
  /*
   * 정적 사이트라 빌드 시점의 "오늘" 이 HTML 에 박제된다. 배포를 안 하면
   * 잔디가 그 주에서 멈춘 것처럼 보이므로, 방문 시점에 창을 다시 계산한다.
   * 발행 날짜 맵(data-counts)만 있으면 재배포 없이 매일 앞으로 나아간다.
   */
  function initGrass() {
    document.querySelectorAll<HTMLElement>("[data-grass]").forEach(el => {
      let counts: Record<string, number>;
      try {
        counts = JSON.parse(el.dataset.counts || "{}");
      } catch {
        return;
      }

      const days = Number(el.dataset.days || 90);
      const unit = el.dataset.unit || "편";
      const tz = el.dataset.tz || "Asia/Seoul";
      const isEn = el.dataset.labelTpl === "en";

      // 발행 캘린더는 블로그 기준 시간대(KST)를 따른다 — 서버 집계와 동일
      const key = (d: Date) =>
        d.toLocaleDateString("en-CA", { timeZone: tz });

      // 마지막 칸은 오늘. 아직 오지 않은 날짜는 그리지 않는다.
      const today = new Date(`${key(new Date())}T00:00:00`);
      const start = new Date(today);
      start.setDate(start.getDate() - (days - 1));
      start.setDate(start.getDate() - start.getDay());

      const DAY = 24 * 60 * 60 * 1000;
      const cellCount =
        Math.round((today.getTime() - start.getTime()) / DAY) + 1;

      const level = (n: number) => (n === 0 ? 0 : n === 1 ? 2 : n === 2 ? 3 : 4);

      // 서버가 그린 칸 수와 오늘 기준 칸 수가 다를 수 있으므로 개수를 맞춘다
      const cells = Array.from(
        el.querySelectorAll<HTMLElement>(".grass-cell")
      );
      const template = cells[0];
      if (!template) return;
      while (cells.length > cellCount) cells.pop()!.remove();
      while (cells.length < cellCount) {
        const clone = template.cloneNode(false) as HTMLElement;
        el.appendChild(clone);
        cells.push(clone);
      }

      let total = 0;
      let firstKey = "";
      let lastKey = "";

      cells.forEach((cell, i) => {
        const d = new Date(start);
        d.setDate(d.getDate() + i);
        const k = key(d);
        const n = counts[k] ?? 0;
        total += n;
        if (i === 0) firstKey = k;
        if (i === cells.length - 1) lastKey = k;
        cell.dataset.lvl = String(level(n));
        cell.title = `${k} · ${n}${unit}`;
      });

      const weeks = Math.ceil(cellCount / 7);
      el.setAttribute(
        "aria-label",
        isEn
          ? `Publishing activity heatmap: ${total} posts over ${weeks} weeks`
          : `발행 활동 히트맵: ${weeks}주 동안 총 ${total}${unit}`
      );

      // 섹션 헤더의 기간 · 편수 요약도 같이 갱신
      const summary = document.querySelector<HTMLElement>(
        "[data-grass-summary]"
      );
      if (summary) {
        summary.textContent = `${firstKey} — ${lastKey} · ${total}${unit}`;
      }
    });
  }

  initGrass();
  document.addEventListener("astro:page-load", initGrass);
</script>
