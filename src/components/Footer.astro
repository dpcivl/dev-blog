---
import type { HTMLAttributes } from "astro/types";
import { SITE } from "@/config";
import MailCopyButton from "./MailCopyButton.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["page-shell", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "border-t border-border py-6",
      "flex flex-col items-center justify-between gap-2 text-[0.78rem] text-muted",
      "sm:flex-row sm:gap-0",
    ]}
  >
    <span>© {currentYear} {SITE.author} · All rights reserved.</span>
    <span class="flex gap-4">
      <a
        href={SITE.profile}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent">GitHub</a
      >
      <a
        data-mail-copy
        href="mailto:dpcivl713@gmail.com"
        class="hover:text-accent">Email</a
      >
      <a href="/rss.xml" class="hover:text-accent">RSS</a>
    </span>
  </div>
</footer>

<MailCopyButton />
