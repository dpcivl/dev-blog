---
import { getCollection, type CollectionEntry } from "astro:content";
import { filterByLang, stripLangPrefix } from "@/utils/i18n";

type Props = {
  project: CollectionEntry<"portfolio">;
};

const { project } = Astro.props;
const {
  title,
  period,
  role,
  company,
  techStack,
  description,
  gallery,
  responsibilities,
  outcomes,
  relatedPosts,
} = project.data;

// 스키마가 레거시 문자열도 받으므로 렌더 전에 정규화한다
type Duty = { k: string; v: string };
const duties: Duty[] = responsibilities.map(r =>
  typeof r === "string" ? { k: "", v: r } : r
);

type Outcome = { value: string; label: string };
const results: Outcome[] = outcomes.map(o =>
  typeof o === "string" ? { value: "", label: o } : o
);

const koPosts = filterByLang(await getCollection("blog"), "ko");
const titleOf = (slug: string) =>
  koPosts.find(p => stripLangPrefix(p.id) === slug)?.data.title ?? slug;
---

<article class="work grid gap-10 pt-8 md:grid-cols-[190px_1fr]">
  {/* ===== 좌: 기간 · 소속 ===== */}
  <div class="work-meta">
    <div class="font-code text-[0.8rem] tracking-[0.04em] text-accent">
      {period}
    </div>
    {company && <div class="mt-2 text-[0.86rem] font-semibold">{company}</div>}
    {role && <div class="mt-1 text-[0.8rem] leading-[1.5] text-muted">{role}</div>}
  </div>

  {/* ===== 우: 본문 ===== */}
  <div>
    <h3 class="text-[1.35rem] font-bold tracking-[-0.015em]">{title}</h3>
    <p class="mt-3 text-[1rem] leading-[1.75] text-muted">{description}</p>

    {
      results.length > 0 && (
        <section class="mt-7">
          <h4 class="section-label">측정된 성과</h4>
          <div class="mt-3 grid gap-3 sm:grid-cols-3">
            {results.map(r => (
              <div class="rounded-lg border border-border p-4">
                {r.value && (
                  <div class="text-[1.05rem] leading-[1.2] font-bold text-accent">
                    {r.value}
                  </div>
                )}
                <div class="mt-1 text-[0.76rem] leading-[1.5] text-muted">
                  {r.label}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      duties.length > 0 && (
        <section class="mt-7">
          <h4 class="section-label">담당 업무</h4>
          <dl class="mt-3">
            {duties.map(d => (
              <div class="duty-row">
                <dt>{d.k}</dt>
                <dd>{d.v}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      techStack.length > 0 && (
        <section class="mt-7">
          <h4 class="section-label">기술 스택</h4>
          <div class="mt-3">
            {techStack.map(t => (
              <span class="tech-badge">{t}</span>
            ))}
          </div>
        </section>
      )
    }

    {
      (gallery.length > 0 || relatedPosts.length > 0) && (
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
          {gallery.length > 0 && (
            <button
              type="button"
              class="arw-link gallery-trigger"
              data-gallery-trigger
              data-gallery-images={JSON.stringify(gallery)}
              data-gallery-title={title}
            >
              📷 사진 보기 ({gallery.length}) <span class="arw">→</span>
            </button>
          )}
          {relatedPosts.map(slug => (
            <a class="arw-link" href={`/posts/${slug}`}>
              {titleOf(slug)} <span class="arw">→</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .work {
    border-top: 1px solid var(--foreground);
  }

  .section-label {
    font-family: var(--font-code);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .duty-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 1.25rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }
  .duty-row:last-child {
    border-bottom: none;
  }
  .duty-row dt {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .duty-row dd {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .duty-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  button.gallery-trigger {
    background: transparent;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    color: var(--accent);
  }

  /* 데스크탑에서만 좌측 컬럼 고정 */
  @media (min-width: 768px) {
    .work-meta {
      position: sticky;
      top: 1rem;
      align-self: start;
    }
  }
</style>
