---
import { getCollection, type CollectionEntry } from "astro:content";
import { filterByLang, stripLangPrefix } from "@/utils/i18n";

type Props = {
  project: CollectionEntry<"portfolio">;
};

const { project } = Astro.props;

// relatedPosts 는 slug 배열이라 실제 제목으로 바꿔 보여준다
const koPosts = filterByLang(await getCollection("blog"), "ko");
const titleOf = (slug: string) =>
  koPosts.find(p => stripLangPrefix(p.id) === slug)?.data.title ?? slug;
const {
  title,
  status,
  period,
  role,
  techStack,
  description,
  gallery,
  relatedPosts,
  links,
  highlight,
} = project.data;

/*
 * outcomes 는 스키마가 레거시 문자열도 받으므로 정규화한다.
 * highlight 로 이미 큰 활자로 세운 값은 중복이라 제외.
 */
type Outcome = { value: string; label: string };
const results: Outcome[] = project.data.outcomes
  .map(o => (typeof o === "string" ? { value: "", label: o } : o))
  .filter(o => !highlight || o.value !== highlight.value);

const STATUS_LABEL: Record<string, string> = {
  "in-progress": "IN PROGRESS",
  completed: "COMPLETED",
  paused: "PAUSED",
};
const statusLabel = status ? STATUS_LABEL[status] : undefined;

const hasFooter =
  gallery.length > 0 ||
  relatedPosts.length > 0 ||
  !!links?.github ||
  !!links?.demo;
---

<article class="tile rounded-xl border border-border px-7 py-6">
  <div class="grid gap-10 md:grid-cols-[1fr_240px]">
    {/* ===== 좌: 서술 ===== */}
    <div>
      {
        statusLabel && (
          <div class="flex items-center gap-2">
            <span class="status-dot" data-status={status} aria-hidden="true" />
            <span class="font-code text-[0.68rem] tracking-[0.12em] text-muted">
              {statusLabel}
            </span>
          </div>
        )
      }

      <h3 class="mt-3 text-[1.5rem] font-bold tracking-[-0.015em]">{title}</h3>

      <p class="mt-3 text-[0.95rem] leading-[1.7] text-muted">{description}</p>

      {
        techStack.length > 0 && (
          <div class="mt-4">
            {techStack.map(t => (
              <span class="tech-badge">{t}</span>
            ))}
          </div>
        )
      }
    </div>

    {/* ===== 우: 지표 · 메타 ===== */}
    <div
      class="border-t border-border pt-5 md:border-t-0 md:border-l md:pt-0 md:pl-6"
    >
      {
        highlight && (
          <div class="mb-5">
            <div class="text-[1.5rem] leading-[1.15] font-bold text-accent">
              {highlight.value}
            </div>
            <div class="mt-1 text-[0.76rem] leading-[1.5] text-muted">
              {highlight.label}
            </div>
          </div>
        )
      }
      <dl class="flex flex-col gap-2 text-[0.82rem]">
        <div class="flex gap-3">
          <dt class="w-10 flex-none text-muted">기간</dt>
          <dd class="m-0">{period}</dd>
        </div>
        {
          role && (
            <div class="flex gap-3">
              <dt class="w-10 flex-none text-muted">역할</dt>
              <dd class="m-0">{role}</dd>
            </div>
          )
        }
      </dl>
    </div>
  </div>

  {
    results.length > 0 && (
      <section class="mt-6">
        <h4 class="section-label">측정된 성과</h4>
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          {results.map(r => (
            <div class="rounded-lg border border-border p-4">
              {r.value && (
                <div class="text-[1.05rem] leading-[1.2] font-bold text-accent">
                  {r.value}
                </div>
              )}
              <div class="mt-1 text-[0.76rem] leading-[1.5] text-muted">
                {r.label}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    hasFooter && (
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-border pt-4">
        {gallery.length > 0 && (
          <button
            type="button"
            class="arw-link gallery-trigger"
            data-gallery-trigger
            data-gallery-images={JSON.stringify(gallery)}
            data-gallery-title={title}
          >
            📷 사진 보기 ({gallery.length}) <span class="arw">→</span>
          </button>
        )}
        {relatedPosts.length > 0 && (
          <details class="related-details">
            <summary>관련 글 {relatedPosts.length}편</summary>
            <ul>
              {relatedPosts.map(slug => (
                <li>
                  <a href={`/posts/${slug}`}>{titleOf(slug)}</a>
                </li>
              ))}
            </ul>
          </details>
        )}
        {links?.github && (
          <a
            class="arw-link"
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub <span class="arw">→</span>
          </a>
        )}
        {links?.demo && (
          <a
            class="arw-link"
            href={links.demo}
            target="_blank"
            rel="noopener noreferrer"
          >
            Live <span class="arw">→</span>
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--accent);
    flex: none;
  }
  .status-dot[data-status="paused"] {
    background: var(--muted);
  }

  .section-label {
    font-family: var(--font-code);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  button.gallery-trigger {
    background: transparent;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    color: var(--accent);
  }

  .related-details {
    font-size: 0.85rem;
  }
  .related-details > summary {
    cursor: pointer;
    color: var(--accent);
    list-style: none;
  }
  .related-details > summary::-webkit-details-marker {
    display: none;
  }
  .related-details > summary::after {
    content: " ▾";
    font-size: 0.7rem;
  }
  .related-details[open] > summary::after {
    content: " ▴";
  }
  .related-details ul {
    margin: 0.5rem 0 0;
    padding-left: 1rem;
    list-style: disc;
  }
  .related-details li {
    margin-bottom: 0.2rem;
  }
  .related-details a {
    color: var(--foreground);
  }
  .related-details a:hover {
    color: var(--accent);
  }
</style>
