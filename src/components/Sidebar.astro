---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import IconRss from "@/assets/icons/IconRss.svg";

// KO/EN 스위처는 Header.astro 로 이동 (모든 페이지 공통이라 헤더가 맞는 자리).
const pathname = Astro.url.pathname;
const isEnglishPage =
  pathname === "/en" || pathname === "/en/" || pathname.startsWith("/en/");
const currentLang: "ko" | "en" = isEnglishPage ? "en" : "ko";
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <img
      src="/profile.webp"
      alt="박효인"
      class="sidebar-profile"
      width="120"
      height="120"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="sidebar-identity">
      <div class="sidebar-name">박효인</div>
      <div class="sidebar-name-en">Park Hyoin</div>
    </div>
    <p class="sidebar-tagline">
      {currentLang === "en"
        ? "Embedded SW · AI Agent · Vibe coding"
        : "임베디드 SW · AI Agent · Vibe coding"}
    </p>
    <div class="sidebar-socials">
      {
        SOCIALS.map(social => (
          <LinkButton
            href={social.href}
            title={social.linkTitle}
            class="sidebar-social-link"
            data-mail-copy={
              social.href.startsWith("mailto:") ? true : undefined
            }
          >
            <social.icon class="sidebar-social-icon" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))
      }
      <LinkButton
        href="/rss.xml"
        title={currentLang === "en" ? "Subscribe to RSS feed" : "RSS 피드 구독"}
        class="sidebar-social-link"
      >
        <IconRss class="sidebar-social-icon" />
        <span class="sr-only">
          {currentLang === "en" ? "Subscribe to RSS feed" : "RSS 피드 구독"}
        </span>
      </LinkButton>
    </div>
  </div>
</aside>


<style>
  .sidebar {
    width: 100%;
    padding: 1.5rem 0 1rem 0;
  }
  .sidebar-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
  }
  .sidebar-profile {
    width: 120px;
    height: 120px;
    border-radius: 9999px;
    object-fit: cover;
    border: 2px solid var(--border);
  }
  .sidebar-identity {
    margin-top: 0.25rem;
  }
  .sidebar-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--foreground);
  }
  .sidebar-name-en {
    font-size: 0.85rem;
    opacity: 0.75;
    letter-spacing: 0.02em;
  }
  .sidebar-tagline {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
    max-width: 200px;
    margin: 0;
  }
  .sidebar-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.4rem;
  }
  .sidebar-social-link {
    padding: 0.4rem;
    border-radius: 6px;
  }
  .sidebar-social-link:hover {
    background: var(--accent-bg);
  }
  .sidebar-social-icon {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    stroke: currentColor;
    fill: transparent;
    stroke-width: 2;
    opacity: 0.85;
  }

  /* Desktop: sticky sidebar */
  @media (min-width: 768px) {
    .sidebar {
      padding: 2rem 0;
      position: sticky;
      top: 1rem;
      align-self: start;
    }
    .sidebar-inner {
      align-items: flex-start;
      text-align: left;
    }
    .sidebar-socials {
      justify-content: flex-start;
    }
    .sidebar-tagline {
      max-width: none;
    }
  }
</style>
