---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StatGrid from "@/components/StatGrid.astro";
import ProjectCard from "@/components/portfolio/ProjectCard.astro";
import WorkCard from "@/components/portfolio/WorkCard.astro";
import GalleryModal from "@/components/portfolio/GalleryModal.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { filterByLang } from "@/utils/i18n";
import { SITE } from "@/config";

const projects = await getCollection("portfolio");

const sorted = projects.sort(
  (a, b) => (b.data.order ?? 0) - (a.data.order ?? 0)
);

const inProgress = sorted.filter(
  p => p.data.type === "side" && p.data.status === "in-progress"
);
const completed = sorted.filter(
  p => p.data.type === "side" && p.data.status === "completed"
);
const paused = sorted.filter(
  p => p.data.type === "side" && p.data.status === "paused"
);
const work = sorted.filter(p => p.data.type === "work");

const sideProjects = [...inProgress, ...completed, ...paused];
const hasAny = sideProjects.length + work.length > 0;

// 회사 R&D 프로젝트 수 — work 항목의 담당 업무 개수 합
const workProjectCount = work.reduce(
  (acc, p) => acc + p.data.responsibilities.length,
  0
);

const koPosts = getSortedPosts(filterByLang(await getCollection("blog"), "ko"));

const stats = [
  { v: "2022.10 — 2025.12", k: "임베디드 HW · SW 경력" },
  { v: `${inProgress.length}개`, k: "배포 · 운영 중인 제품" },
  { v: `${workProjectCount}개`, k: "회사 R&D 프로젝트" },
  { v: `${koPosts.length}편`, k: "공개 기록" },
];

const lastUpdated = new Date().toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={`포트폴리오 | ${SITE.title}`} noIndex={true}>
  <Header />
  <div class="page-narrow">
    <main id="main-content" data-pagefind-ignore>
      {/* ===== 히어로 ===== */}
      <section class="pt-14 pb-8">
        <div class="flex items-center gap-3">
          <span
            class="font-code text-[0.72rem] font-bold tracking-[0.16em] text-accent"
          >
            PORTFOLIO
          </span>
          <span class="unlisted-badge">UNLISTED</span>
        </div>

        {/*
          TODO(카피): 아래 h1 은 작성자가 직접 쓸 문장으로 교체할 자리다.
          지시서 초안("측정한 결과와, 고치지 못한 것까지 남긴 작업들") 은
          Claude 가 쓴 카피라 넣지 않았다.
          리드 문단은 기존 포트폴리오 페이지에 있던 문장을 그대로 옮겼다.
        */}
        <h1
          class="mt-4 text-[2.6rem] leading-[1.3] font-bold tracking-[-0.02em] text-balance"
        >
          <span class="copy-todo">[포트폴리오 제목 — 직접 쓰실 문장을 넣어주세요]</span>
        </h1>

        <p class="mt-5 max-w-[42rem] text-[1.02rem] leading-[1.75] text-muted">
          각 카드는 관련 블로그 글로 연결됩니다. 자세한 사고 과정과 트러블슈팅은
          본문 글에서 확인하세요. 더 자세한 자기소개는 <a
            href="/about"
            class="text-accent">About 페이지</a
          >에서 볼 수 있습니다.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {/*
            이력서 PDF 버튼은 넣지 않았다 — public/ 에 PDF 파일이 없다.
            파일을 추가하면 여기에 primary 버튼으로 되살릴 수 있다.
          */}
          <a href="mailto:dpcivl713@gmail.com" class="pf-btn pf-btn-primary" data-mail-copy>
            이메일 복사
          </a>
          <a href="/about" class="pf-btn">About</a>
          <a
            href={SITE.profile}
            class="pf-btn"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </div>

        <p class="mt-5 text-[0.74rem] opacity-80">
          마지막 업데이트: {lastUpdated}
        </p>
      </section>

      {/* ===== 지표 ===== */}
      <StatGrid items={stats} />

      {
        !hasAny && (
          <section class="pt-12 pb-12 text-center opacity-75">
            <p>아직 등록된 프로젝트가 없습니다.</p>
          </section>
        )
      }

      {/* ===== 사이드 프로젝트 =====
          상태별 3분할은 카드 내부 상태 라벨로 흡수했다.
          completed / paused 가 늘어나면 아래 배열을 소제목별로 다시 쪼개면 된다. */}
      {
        sideProjects.length > 0 && (
          <section class="pt-12">
            <h2 class="section-label">SIDE PROJECTS</h2>
            <div class="mt-5 flex flex-col gap-6">
              {sideProjects.map(project => (
                <ProjectCard project={project} />
              ))}
            </div>
          </section>
        )
      }

      {/* ===== 경력 ===== */}
      {
        work.length > 0 && (
          <section class="pt-14 pb-16">
            <h2 class="section-label">EXPERIENCE</h2>
            <div class="mt-5 flex flex-col gap-10">
              {work.map(project => (
                <WorkCard project={project} />
              ))}
            </div>
          </section>
        )
      }
    </main>
  </div>
  <Footer />
  <GalleryModal />
</Layout>

<style>
  .section-label {
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .unlisted-badge {
    font-family: var(--font-code);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
  }

  .copy-todo {
    display: inline-block;
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0;
    border: 1px dashed var(--border);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
  }

  .pf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--foreground);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .pf-btn:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .pf-btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--background);
    font-weight: 600;
  }
  .pf-btn-primary:hover {
    opacity: 0.92;
  }
  @media (prefers-reduced-motion: reduce) {
    .pf-btn {
      transition: none;
    }
    .pf-btn:hover {
      transform: none;
    }
  }
</style>
