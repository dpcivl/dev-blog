---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Grass from "@/components/Grass.astro";
import StatGrid from "@/components/StatGrid.astro";
import PostRow from "@/components/PostRow.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPublishActivity } from "@/utils/getPublishActivity";
import { filterByLang } from "@/utils/i18n";
import { SITE } from "@/config";

const enPosts = filterByLang(await getCollection("blog"), "en");
const sortedPosts = getSortedPosts(enPosts);

// 잔디는 KO 원본 발행 흐름을 보여준다 (EN 은 번역본이라 발행일이 KO 를 따라옴)
const koPosts = filterByLang(await getCollection("blog"), "ko");
const activity = getPublishActivity(koPosts);

const projects = await getCollection("portfolio");
const liveProjects = projects.filter(
  p => p.data.type === "side" && p.data.status === "in-progress"
);

const stats = [
  { v: `${sortedPosts.length}`, k: "Posts in English" },
  { v: "2022.10 — 2025.12", k: "Embedded HW · SW" },
  { v: `${liveProjects.length}`, k: "Products I ship & run" },
  { v: `${getSortedPosts(koPosts).length}`, k: "Posts in Korean" },
];
---

<Layout>
  <Header />
  <div class="page-narrow">
    <main id="main-content" data-layout="index">
      {/* ===== 히어로 ===== */}
      <section class="grid gap-10 pt-16 pb-10 sm:grid-cols-[1fr_132px]">
        <div class="order-2 sm:order-1">
          <p
            class="font-code text-[0.72rem] font-bold tracking-[0.16em] text-accent"
          >
            박효인 · PARK HYOIN
          </p>

          <h1
            class="mt-4 text-[2.9rem] leading-[1.28] font-bold tracking-[-0.02em] text-balance"
          >
            I write down what I build — and <span class="hl">where I get stuck</span>.
          </h1>

          <p class="mt-5 max-w-[44rem] text-[1.05rem] text-muted text-pretty">
            Notes on what I learn and build.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={SITE.profile}
              class="hero-btn"
              target="_blank"
              rel="noopener noreferrer">GitHub</a
            >
            <a href="mailto:dpcivl713@gmail.com" class="hero-btn" data-mail-copy>
              Copy email
            </a>
          </div>
        </div>

        <img
          src="/profile.webp"
          alt="Park Hyoin"
          width="132"
          height="132"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="order-1 size-[132px] rounded-full border-2 border-border object-cover sm:order-2"
        />
      </section>

      {/* ===== 지표 ===== */}
      <StatGrid items={stats} />

      {/* ===== 발행 기록 ===== */}
      <section class="rise-init pt-12" data-rise>
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <h2 class="text-[0.95rem] font-semibold">Publishing activity</h2>
          <span class="font-code text-[0.72rem] text-muted">
            {activity.firstDate} — {activity.lastDate} · {activity.total} posts
          </span>
        </div>
        <Grass
          data={activity.data}
          dates={activity.dates}
          total={activity.total}
          unit=" posts"
          label={`Publishing activity heatmap: ${activity.total} posts over ${activity.weeks} weeks`}
          legendLow="Less"
          legendHigh="More"
        />
      </section>

      {/* ===== 최근 기록 ===== */}
      {
        sortedPosts.length > 0 ? (
          <section class="rise-init pt-12 pb-16" data-rise>
            <div class="mb-2 flex items-baseline justify-between gap-4">
              <h2 class="text-[0.95rem] font-semibold">Recent posts</h2>
              <a href="/en/posts" class="arw-link text-[0.8rem]">
                All {sortedPosts.length} <span class="arw">→</span>
              </a>
            </div>
            <div>
              {sortedPosts.slice(0, SITE.postPerIndex).map(post => (
                <PostRow post={post} />
              ))}
            </div>
          </section>
        ) : (
          <section class="rise-init pt-12 pb-16" data-rise>
            <h2 class="text-[0.95rem] font-semibold">
              English translations coming soon
            </h2>
            <p class="mt-3 text-[0.95rem] leading-[1.7] text-muted">
              I'm translating my Korean posts to English. Meanwhile, feel free to
              browse the <a class="text-accent" href="/">Korean version</a> — most
              posts include code, diagrams, and screenshots that are
              language-independent.
            </p>
          </section>
        )
      }
    </main>
  </div>
  <Footer />
</Layout>

<style>
  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--foreground);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .hero-btn:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-btn {
      transition: none;
    }
    .hero-btn:hover {
      transform: none;
    }
  }
</style>

<script>
  function initIndex() {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/en/");
    }

    const targets = document.querySelectorAll<HTMLElement>("[data-rise]");
    if (!targets.length) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      targets.forEach(el => el.classList.remove("rise-init"));
      return;
    }

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          el.classList.remove("rise-init");
          el.classList.add("rise");
          observer.unobserve(el);
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
    );

    targets.forEach(el => observer.observe(el));
  }

  initIndex();
  document.addEventListener("astro:page-load", initIndex);
</script>
