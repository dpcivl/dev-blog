#!/bin/sh
# push 는 공개 경계다. 저장소 전체를 검사한다.
#
# pre-commit 이 스테이지된 줄만 보는 것과 달리 여기서는 check:md 를 통째로
# 돌린다 — 미렌더 mermaid · 공인 IP · KO/EN 짝 깨짐은 한 커밋의 추가 줄만
# 봐서는 알 수 없다.
#
# 번역 페어 검증(pnpm translate:validate)은 여기 넣지 않는다 (작성자 결정,
# 2026-11-14). 지금 95쌍 중 23건이 걸리는데 대부분 코드 주석 번역과 길이
# 비율이라 막을 근거가 못 된다. 점검은 손으로 돌린다.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node 가 없어 발행 검사를 건너뜁니다." >&2
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
echo "pre-push: 발행 검사 중…"
if ! node "$root/scripts/check-markdown.mjs"; then
  echo ""
  echo "  → push 를 멈췄습니다. 위 🔴 항목을 고치고 다시 push 하세요."
  echo "     (경고 ⚠️ 는 막지 않습니다.)"
  exit 1
fi
exit 0
