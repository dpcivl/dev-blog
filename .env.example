# For scripts/translate — KO→EN 번역 파이프라인
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: override model. 기본값은 scripts/translate/translate-one.mjs 의 claude-sonnet-5.
# 번역은 원문이 확정된 상태에서 옮기는 배치 작업이라 Sonnet 5 가 적절하다.
# Alternatives: claude-opus-5 (판단이 필요한 글), claude-haiku-4-5 (저가·200K 컨텍스트)
# ANTHROPIC_MODEL=claude-sonnet-5

# For scripts/embed — 검색 인덱스 (RAG Phase 1)
# 임베딩은 Anthropic 이 제공하지 않는다. 공식 문서가 Voyage AI 를 권하는데
# 여기서는 OpenAI 를 쓴다. 인덱스 전체가 $0.005 수준이라 비용은 사실상 없다.
#   node scripts/embed/estimate.mjs   ← 키 없이도 비용 견적만 볼 수 있다
OPENAI_API_KEY=sk-xxx
# Optional: 기본값은 text-embedding-3-small ($0.02/1M). large 는 $0.13/1M.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
