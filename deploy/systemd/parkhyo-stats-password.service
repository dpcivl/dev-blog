# 소켓이 깨우면 뜨고, 60초 조용하면 스스로 내려간다.
#
# 인증은 nginx 가 한다. 이 유닛은 basic auth 로 막힌 location 뒤에만
# 연결돼 있어서, 여기까지 온 요청은 현재 비밀번호를 아는 요청이다.
#
# htpasswd 파일을 쓰려면 권한이 필요한데 sudo 를 주지 않는다. 대신 파일
# 소유를 바꿔서 이 서비스 계정이 쓰고 nginx(www-data)가 읽게 한다.
#
#   sudo chown statspw:www-data /etc/nginx/.htpasswd-stats
#   sudo chmod 640 /etc/nginx/.htpasswd-stats
#
# sudo 규칙을 안 쓰는 이유: sudoers 는 한 줄 잘못 쓰면 범위가 넓어지는데,
# 파일 소유권은 그 파일 하나로 끝난다.
#
# Python 으로 돌린다. 이 서버에는 Node 가 없다 — 빌드는 CI 에서 하고 서버는
# 정적 파일만 서빙해 왔다. 작은 일 하나 때문에 런타임을 더 들이지 않는다.

[Unit]
Description=parkhyo.in 통계 비밀번호 변경
Requires=parkhyo-stats-password.socket
After=parkhyo-stats-password.socket

[Service]
Type=simple
User=statspw
Group=statspw
ExecStart=/usr/bin/python3 /opt/parkhyo/server/stats_password_service.py
Environment=HTPASSWD_FILE=/etc/nginx/.htpasswd-stats
Environment=HTPASSWD_USER=admin
Environment=IDLE_SEC=60

# 비밀번호를 바꾸는 일 외에 아무것도 못 하게 한다.
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/nginx/.htpasswd-stats
RestrictAddressFamilies=AF_UNIX
MemoryMax=96M

[Install]
WantedBy=multi-user.target
