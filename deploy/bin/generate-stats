#!/usr/bin/env bash
# nginx 접근 로그로 방문 통계 HTML 을 만든다. cron 이 시간마다 호출.
#   설치: sudo install -m 755 generate-stats /usr/local/bin/generate-stats
#
# --persist/--restore 로 누적 DB 를 쓴다. 이게 없으면 logrotate 가 로그를
# 지울 때 과거 통계도 같이 사라진다 (Ubuntu 기본: 매일 회전, 14개 보관).
set -euo pipefail

LOG=/var/log/nginx/access.log
OUT=/var/www/stats/index.html
DB=/var/lib/goaccess

command -v goaccess >/dev/null || { echo "goaccess 미설치" >&2; exit 1; }
[ -r "$LOG" ] || { echo "로그를 읽을 수 없다: $LOG" >&2; exit 1; }
mkdir -p "$(dirname "$OUT")" "$DB"

goaccess "$LOG" \
  --log-format=COMBINED \
  --persist --restore --db-path="$DB" \
  --ignore-crawlers \
  --real-os \
  --html-report-title="parkhyo.in" \
  --tz=Asia/Seoul \
  --static-file=.webp \
  --static-file=.avif \
  --static-file=.woff2 \
  --static-file=.mp4 \
  -o "$OUT"

# nginx 가 읽을 수 있게
chmod 644 "$OUT"
